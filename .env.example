# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding Model
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# LLM Model
# LLM_MODEL=z-ai/glm-4.5-air:free
# LLM_MODEL=openai/gpt-oss-120b:free
LLM_MODEL=poolside/laguna-m.1:free


# ChromaDB Configuration
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# App Configuration
APP_HOST=0.0.0.0
APP_PORT=8080

# Query Expansion (Stage 2) — when enabled, generates synonym queries on low-relevance results
# QUERY_EXPANSION_ENABLED=true
# QUERY_EXPANSION_COUNT=3

# Loose Prompt (Stage 3) — when enabled, relaxes system prompt to allow general knowledge answers
# LOOSE_PROMPT_ENABLED=true

# Confluence integration
CONFLUENCE_TIMEOUT_SECONDS=60
CONFLUENCE_PAGE_LIMIT=100
CONFLUENCE_MAX_PAGES=2000
CONFLUENCE_EMBED_BATCH_SIZE=64
# Comma-separated allowed Confluence hosts (SSRF guard). Empty = allow all.
CONFLUENCE_ALLOWED_HOSTS=

# Jev relevance reranker (TypeSafe via OpenRouter)
# Jev is a discriminative model: it scores chunks (yes/no or 0-3 grade)
# WITHOUT generating text. Use it as a pre-reranker before the LLM.
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.13
JEV_PROVIDER=openrouter
JEV_BASE_URL=https://openrouter.ai/api
JEV_QUESTION_MODE=noul
JEV_SCORING_MODE=per_chunk
JEV_THRESHOLD=0.5
JEV_SCORE_THRESHOLD=2.0
JEV_MAX_CONCURRENCY=8
JEV_TIMEOUT_S=30
JEV_FAIL_OPEN=true

# Vision / Image understanding (VLM via OpenRouter)
VISION_ENABLED=false
VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_TIMEOUT_S=60
VISION_MAX_IMAGES_PER_PAGE=5
VISION_MAX_CONCURRENCY=4
VISION_EXTRACT_DIR=data/vision_extracts
VISION_DESCRIPTION_LANGUAGE=fa

# Vision page rendering (captures vector drawings / geometry)
VISION_RENDER_PAGES=false
VISION_RENDER_DPI=150

# PDF loading performance
PDF_PARALLEL_WORKERS=4
PDF_PARALLEL_MIN_PAGES=50
